// Post and Stuff Mail Portal database schema.
// Tables follow the "Data model" section of the build guide.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum BillingTerms {
  NET30
  NET60
}

// Who pays for a client's mailbox: their partner nonprofit, or the client.
enum BillingType {
  NONPROFIT
  SELF_PAY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum UserRole {
  ADMIN
  STAFF
  CASE_MANAGER
  ORG_ADMIN
}

enum MailType {
  LETTER
  FLAT
  PACKAGE
}

enum MailStatus {
  RECEIVED
  SCAN_REQUESTED
  OPENED
  READY_FOR_PICKUP
  PICKED_UP
  RETURNED
  SHREDDED
}

enum ImageKind {
  ENVELOPE
  CONTENTS
}

enum RequestType {
  OPEN_AND_SCAN
  HOLD
  PICKUP
  DISCARD
}

enum RequestStatus {
  OPEN
  DONE
  CANCELLED
}

enum PickupMethod {
  CODE
  ID
}

enum AuditAction {
  VIEW
  UPLOAD
  DOWNLOAD
  LOGIN
  LOGIN_FAILED
  PIN_RESET
}

enum ApplicationStatus {
  PENDING
  CONVERTED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Organization {
  id           String       @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  billingTerms BillingTerms @default(NET30)
  monthlyRate  Decimal      @default(15.00) @db.Decimal(10, 2)
  createdAt    DateTime     @default(now())

  clients      Client[]
  users        User[]
  invoices     Invoice[]
  applications Application[]
}

model Client {
  id             String       @id @default(cuid())
  pmbNumber      String       @unique
  firstName      String
  lastName       String
  phone          String?
  // Where self-pay bills are emailed (from the sign-up, or typed in by staff).
  email          String?
  pinHash        String
  // Null for self-pay clients (no sponsoring nonprofit).
  orgId          String?
  billingType    BillingType  @default(NONPROFIT)
  // Self-pay only: what the client pays per month, set by staff at activation.
  monthlyPrice   Decimal?     @db.Decimal(10, 2)
  // When the client agreed to get their monthly bill by text. Null = never text bills.
  billSmsConsentAt DateTime?
  status         ClientStatus @default(ACTIVE)
  form1583OnFile Boolean      @default(false)
  idExpiresAt    DateTime?
  // Owner policy: mail is held 90 days, then returned to sender or shredded.
  holdDays       Int          @default(90)
  // When the client agreed (signed intake form) to text alerts. Null = never text.
  smsConsentAt   DateTime?
  // Login lockout: 5 wrong PINs locks the account for 15 minutes.
  failedLogins   Int          @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime     @default(now())
  // Billing: the nonprofit pays from the enrollment month, at least 3 months
  // (90-day minimum), and through the month the enrollment ends.
  enrolledAt     DateTime     @default(now())
  endedAt        DateTime?

  org            Organization?   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  clientInvoices ClientInvoice[]
  mailItems    MailItem[]
  delegates    Delegate[]
  auditLogs    AuditLog[]
  invoiceLines InvoiceLine[]
  application  Application?

  @@index([orgId])
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String
  role               UserRole
  orgId              String?
  twoFactorSecret    String?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  // Set when staff create the account or reset the password: the person must
  // pick their own password before doing anything else.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())

  org       Organization? @relation(fields: [orgId], references: [id])
  delegates Delegate[]
  requests  Request[]
  pickups   Pickup[]
  auditLogs AuditLog[]
}

// Who may see whose mail (case managers, caregivers).
model Delegate {
  id         String    @id @default(cuid())
  clientId   String
  userId     String
  approvedAt DateTime  @default(now())
  revokedAt  DateTime?

  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([clientId, userId])
}

model MailItem {
  id            String     @id @default(cuid())
  clientId      String
  receivedAt    DateTime   @default(now())
  sender        String?
  type          MailType   @default(LETTER)
  urgent        Boolean    @default(false)
  status        MailStatus @default(RECEIVED)
  shelfLocation String?
  retainUntil   DateTime

  client    Client      @relation(fields: [clientId], references: [id])
  images    MailImage[]
  requests  Request[]
  pickups   Pickup[]
  auditLogs AuditLog[]

  @@index([clientId, receivedAt])
  @@index([retainUntil])
}

model MailImage {
  id         String    @id @default(cuid())
  mailItemId String
  kind       ImageKind
  r2Key      String    @unique
  pageNumber Int       @default(1)
  createdAt  DateTime  @default(now())

  mailItem MailItem @relation(fields: [mailItemId], references: [id])
}

model Request {
  id            String        @id @default(cuid())
  mailItemId    String
  // Null when the client made the request themselves (clients aren't Users).
  requestedById String?
  type          RequestType
  status        RequestStatus @default(OPEN)
  createdAt     DateTime      @default(now())

  mailItem    MailItem @relation(fields: [mailItemId], references: [id])
  requestedBy User?    @relation(fields: [requestedById], references: [id])

  @@index([status])
}

model Pickup {
  id                String       @id @default(cuid())
  mailItemId        String
  pickedUpAt        DateTime     @default(now())
  verifiedById      String
  method            PickupMethod
  signatureImageKey String?

  mailItem   MailItem @relation(fields: [mailItemId], references: [id])
  verifiedBy User     @relation(fields: [verifiedById], references: [id])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  clientId   String?
  action     AuditAction
  mailItemId String?
  ip         String?
  at         DateTime    @default(now())

  user     User?     @relation(fields: [userId], references: [id])
  client   Client?   @relation(fields: [clientId], references: [id])
  mailItem MailItem? @relation(fields: [mailItemId], references: [id])

  @@index([at])
}

model Invoice {
  id            String        @id @default(cuid())
  orgId         String
  periodStart   DateTime
  periodEnd     DateTime
  activeClients Int
  amount        Decimal       @db.Decimal(10, 2)
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  // Billing month this invoice covers, as "YYYY-MM" (Pacific time).
  month         String        @default("")

  org   Organization  @relation(fields: [orgId], references: [id])
  lines InvoiceLine[]

  @@unique([orgId, periodStart])
}

// One billed client on an invoice, frozen at the time the invoice was made.
model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  clientId    String
  clientName  String
  pmbNumber   String
  amount      Decimal @db.Decimal(10, 2)
  // True when billed only because of the 90-day minimum (client already left).
  minimumOnly Boolean @default(false)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id])

  @@unique([invoiceId, clientId])
}

// Online sign-up (postandstuff.com/signup): the person reads and e-signs the
// client agreement. Staff turn it into a Client on a 1583 / ID day.
model Application {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  phone            String?
  email            String?
  orgId            String?
  caseManagerName  String?
  caseManagerEmail String?
  dateOfBirth      DateTime?
  // Typed in when their nonprofit isn't in the list yet.
  orgOther         String?
  // Agreed online that the named case manager may see their mail.
  delegateConsent  Boolean           @default(false)
  // Exact agreement wording agreed to (see src/lib/agreement.ts) and the typed signature.
  agreementVersion String
  signatureName    String
  signedAt         DateTime          @default(now())
  smsConsent       Boolean           @default(false)
  // No sponsoring nonprofit: the client pays the monthly price themselves.
  selfPay          Boolean           @default(false)
  // Self-pay: agreed to get the monthly bill by text.
  billSmsConsent   Boolean           @default(false)
  ip               String?
  userAgent        String?
  status           ApplicationStatus @default(PENDING)
  clientId         String?           @unique
  createdAt        DateTime          @default(now())

  org    Organization? @relation(fields: [orgId], references: [id])
  client Client?       @relation(fields: [clientId], references: [id])

  @@index([status, createdAt])
}

// A self-pay client's monthly bill, sent by email and/or text.
model ClientInvoice {
  id          String        @id @default(cuid())
  clientId    String
  // Billing month, "YYYY-MM" (Pacific time). One bill per client per month.
  month       String
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime
  status      InvoiceStatus @default(DRAFT)
  emailedAt   DateTime?
  textedAt    DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, month])
  @@index([status])
}
