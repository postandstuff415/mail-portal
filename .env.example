# Local secrets live in .env.local (git-ignored). Never commit real values.
# `neon link` / `neon checkout` fill in the Neon values below automatically.

# Database (Neon). Pooled URL for the app, unpooled URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEON_BRANCH=""

# Neon Object Storage (S3-compatible). Mail scans go in the private "mail" bucket.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
MAIL_BUCKET="mail"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""
# Local `npm start` only. On Vercel this is automatic; elsewhere set AUTH_URL instead.
AUTH_TRUST_HOST=true

# Vercel Cron sends this as a Bearer token to /api/cron/*. Any long random string.
CRON_SECRET=""

# Twilio SMS (alerts and PIN resets). Texts are only logged (dry run) until
# SMS_LIVE=true AND the account, key, and sender below are all set.
SMS_LIVE="false"
TWILIO_ACCOUNT_SID=""
# Preferred: a Standard API key made just for this app (Console > API keys & tokens).
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
# Fallback only if no API key: the account's main auth token.
TWILIO_AUTH_TOKEN=""
# Sender: the A2P 10DLC Messaging Service (preferred) or a single number.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM_NUMBER=""

# Resend email (invoices). Emails are only logged (dry run) until EMAIL_LIVE=true
# and the key + verified sender domain are set.
EMAIL_LIVE="false"
RESEND_API_KEY=""
EMAIL_FROM="Post and Stuff <mail@postandstuff.com>"

# Public site URL
APP_URL="http://localhost:3000"
