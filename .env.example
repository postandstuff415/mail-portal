# Copy this file to .env and fill in real values. Never commit .env.

# Database (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""

# File storage for mail scans (S3-compatible, private bucket)
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_MAIL="mail-scans"
S3_BUCKET_BACKUPS="db-backups"

# Twilio SMS (alerts and PIN resets)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend email (case manager invites, invoices)
RESEND_API_KEY=""
EMAIL_FROM="Post and Stuff <mail@example.com>"

# Public site URL
APP_URL="http://localhost:3000"
