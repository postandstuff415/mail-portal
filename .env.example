# Local secrets live in .env.local (git-ignored). Never commit real values.
# `neon link` / `neon checkout` fill in the Neon values below automatically.

# Database (Neon). Pooled URL for the app, unpooled URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEON_BRANCH=""

# Neon Object Storage (S3-compatible). Mail scans go in the private "mail" bucket.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
MAIL_BUCKET="mail"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""
# Local `npm start` only. On Vercel this is automatic; elsewhere set AUTH_URL instead.
AUTH_TRUST_HOST=true

# Twilio SMS (alerts and PIN resets)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend email (case manager invites, invoices)
RESEND_API_KEY=""
EMAIL_FROM="Post and Stuff <mail@postandstuff.com>"

# Public site URL
APP_URL="http://localhost:3000"
