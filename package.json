{
    "name":  "mail-portal",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint",
                    "db:generate":  "prisma generate",
                    "db:migrate":  "dotenv -e .env.local -- prisma migrate dev",
                    "db:seed":  "dotenv -e .env.local -- prisma db seed",
                    "test":  "dotenv -e .env.local -- vitest run",
                    "typecheck":  "tsc --noEmit",
                    "db:studio":  "dotenv -e .env.local -- prisma studio",
                    "test:e2e":  "dotenv -e .env.local -- tsx scripts/e2e-url-tamper.ts",
                    "twilio:check":  "dotenv -e .env.local -- tsx scripts/twilio-check.ts",
                    "postinstall":  "prisma generate"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.1149.0",
                         "@aws-sdk/s3-request-presigner":  "^3.1149.0",
                         "@base-ui/react":  "^1.9.0",
                         "@neon/config":  "^1.8.6",
                         "@neon/env":  "^1.5.3",
                         "@prisma/client":  "^6.19.3",
                         "bcryptjs":  "^3.0.3",
                         "browser-image-compression":  "^2.0.2",
                         "class-variance-authority":  "^0.7.1",
                         "cn":  "^0.4.0",
                         "jsqr":  "^1.4.0",
                         "lucide-react":  "^1.55.0",
                         "next":  "15.5.27",
                         "next-auth":  "^5.0.0-beta.32",
                         "otplib":  "^13.5.0",
                         "prisma":  "^6.19.3",
                         "qrcode":  "^1.5.4",
                         "react":  "19.1.0",
                         "react-dom":  "19.1.0",
                         "resend":  "^6.32.1",
                         "shadcn":  "^4.21.4",
                         "tw-animate-css":  "^1.4.0",
                         "twilio":  "^6.1.2",
                         "zod":  "^4.6.6"
                     },
    "devDependencies":  {
                            "@eslint/eslintrc":  "^3",
                            "@tailwindcss/postcss":  "^4",
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/node":  "^24.19.2",
                            "@types/qrcode":  "^1.5.6",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "dotenv-cli":  "^11.0.0",
                            "eslint":  "^9",
                            "eslint-config-next":  "15.5.27",
                            "tailwindcss":  "^4",
                            "tsx":  "^4.23.15",
                            "typescript":  "^5",
                            "vitest":  "^5.0.3"
                        },
    "prisma":  {
                   "seed":  "tsx prisma/seed.ts"
               },
    "allowScripts":  {
                         "prisma@6.19.3":  true,
                         "@prisma/client@6.19.3":  true,
                         "@prisma/engines@6.19.3":  true,
                         "esbuild@0.28.2":  true,
                         "unrs-resolver@1.12.2":  true
                     }
}